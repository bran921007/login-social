{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "require": {
        "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ~8.5.12",
        "laravel/framework": "^12.0",
        "hybridauth/hybridauth": "^3.13",
        "ext-curl": "*"
    },
    "autoload": {
        "classmap": [
            "app/controllers",
            "app/models",
            "app/database/seeds"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {},
        "vendor-dir": "vendor-runtime"
    },
    "minimum-stability": "stable"
}
